# Environment Configuration Template
# Copy this file to .env and fill in your environment-specific values.
# NEVER commit your actual .env file with real credentials to version control.

# Server Port
PORT=3000

# MongoDB Connection URI (Local or MongoDB Atlas)
# Local: mongodb://127.0.0.1:27017/assigncheck
# Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/assigncheck?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/assigncheck

# Secret key for signing JWT tokens (generate a long, random string in production)
JWT_SECRET=your_secure_random_jwt_secret_key_here
